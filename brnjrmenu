local function computeStatus()
    if os.clock() < State.noticeUntil then return State.notice end
    if not State.enabled then return "Disabled" end
    if State.paused then return State.respawnText or "Respawning..." end
    if State.current then
        local hrp = getCharacter()
        local pos = getTargetPosition(State.current)
        local suffix = ""
        if hrp and pos then
            suffix = " - " .. math.floor((hrp.Position - pos).Magnitude) .. " studs"
        end
        return (State.phase or "Targeting") .. suffix
    end
    if not scanFolder then return "Pickups folder not found" end
    if not State.autoTarget then return "Manual mode - press Target Nearest" end
    return "Waiting for ShopModel"
end

task.spawn(function()
    while not State.destroyed do
        pcall(function()
            statusText.Text = computeStatus()
            queueText.Text = tostring(pendingCount)
        end)
        task.wait(0.25)
    end
end)

