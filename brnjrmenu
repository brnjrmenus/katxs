-- // Close / full cleanup
local api = {}
local function Destroy()
    if State.destroyed then return end
    stopAll()
    State.destroyed = true

    -- Retire the respawn system (kills the waiter, drops the Died connection)
    respawn.session += 1
    respawn.bindId += 1
    respawn.waiting = false
    if respawn.diedConn then
        pcall(function() respawn.diedConn:Disconnect() end)
        respawn.diedConn = nil
    end

    -- Retire the Player tab features and the collector (saved settings are left untouched)
    ESP.stop()
    if ESP.holder then pcall(function() ESP.holder:Destroy() end) end
    Collect.disarmAll()
    Collect.onChange = nil
    Player.jumpOff()
    Player.bindId += 1
    Player.clearConns()

    for _, c in ipairs(uiConns) do pcall(function() c:Disconnect() end) end
    for _, c in ipairs(coreConns) do pcall(function() c:Disconnect() end) end
    table.clear(uiConns)
    table.clear(coreConns)
    if gui then pcall(function() gui:Destroy() end) end

    if CONFIG.AntiAFKStopOnClose and antiAFK then
        pcall(antiAFK.Disconnect)
    end
    if env.__ShopTweenKATX == api then env.__ShopTweenKATX = nil end
end
api.Destroy = Destroy
env.__ShopTweenKATX = api

