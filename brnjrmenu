-- // ShopModel ESP: its own scanner, only runs while the ESP toggle is ON
local ESP = { holder = nil, items = {}, folder = nil, folderConn = nil, token = 0, running = false }

function ESP.remove(model)
    local it = ESP.items[model]
    if not it then return end
    ESP.items[model] = nil
    pcall(function() it.conn:Disconnect() end)
    pcall(function() it.hl:Destroy() end)
end

function ESP.add(inst)
    if State.destroyed or not ESP.holder then return end
    if inst.Name ~= CONFIG.TargetName then return end
    if not (inst:IsA("Model") or inst:IsA("BasePart")) then return end
    if ESP.items[inst] then return end

    local hl = Instance.new("Highlight")
    hl.Name = "ShopESP"
    hl.Adornee = inst
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop -- visible through walls
    hl.FillColor = CONFIG.ESPFill
    hl.FillTransparency = CONFIG.ESPFillAlpha
    hl.OutlineColor = CONFIG.ESPOutline
    hl.OutlineTransparency = 0
    hl.Parent = ESP.holder

    local conn = inst.AncestryChanged:Connect(function()
        if not inst:IsDescendantOf(Workspace) then ESP.remove(inst) end
    end)
    ESP.items[inst] = { hl = hl, conn = conn }
end

function ESP.detach()
    if ESP.folderConn then
        pcall(function() ESP.folderConn:Disconnect() end)
        ESP.folderConn = nil
    end
    for model in pairs(ESP.items) do ESP.remove(model) end
    ESP.folder = nil
end

function ESP.sync()
    local wi = Workspace:FindFirstChild("WorldIgnore")
    local folder = wi and wi:FindFirstChild("Pickups")
    if folder == ESP.folder then return end
    ESP.detach()
    if not folder then return end

    ESP.folder = folder
    ESP.folderConn = folder.DescendantAdded:Connect(function(d)
        pcall(ESP.add, d)
    end)
    for _, d in ipairs(folder:GetDescendants()) do
        pcall(ESP.add, d)
    end
end

function ESP.start()
    if ESP.running or State.destroyed then return end
    ESP.running = true
    ESP.token += 1
    local myToken = ESP.token
    task.spawn(function()
        while ESP.running and ESP.token == myToken and not State.destroyed do
            local ok, err = pcall(ESP.sync)
            if not ok then warn("[ShopTween] ESP error: " .. tostring(err)) end
            task.wait(CONFIG.ScanInterval)
        end
    end)
end

function ESP.stop()
    ESP.running = false
    ESP.token += 1
    ESP.detach()
end

-- // WalkSpeed / JumpPower / Infinite Jump
-- Values are only enforced once you have moved the slider (nil = leave the game's own value alone).
local Player = { conns = {}, bindId = 0, jumpConn = nil }

function Player.humanoid()
    local char = LocalPlayer.Character
    return char and char:FindFirstChildOfClass("Humanoid")
end

function Player.readWalk()
    local hum = Player.humanoid()
    return hum and hum.WalkSpeed or CONFIG.DefaultWalkSpeed
end

-- Slider unit is "JumpPower". Games using JumpHeight get the equivalent height: h = v^2 / (2g)
function Player.readJump()
    local hum = Player.humanoid()
    if not hum then return CONFIG.DefaultJumpPower end
    if hum.UseJumpPower then return hum.JumpPower end
    return math.sqrt(2 * Workspace.Gravity * hum.JumpHeight)
end

function Player.apply(hum)
    hum = hum or Player.humanoid()
    if not hum then return end
    if State.walkSpeed and hum.WalkSpeed ~= State.walkSpeed then
        hum.WalkSpeed = State.walkSpeed
    end
    if State.jumpPower then
        if hum.UseJumpPower then
            if hum.JumpPower ~= State.jumpPower then hum.JumpPower = State.jumpPower end
        else
            local h = State.jumpPower ^ 2 / (2 * Workspace.Gravity)
            if math.abs(hum.JumpHeight - h) > 0.001 then hum.JumpHeight = h end
        end
    end
end

function Player.clearConns()
    for _, c in ipairs(Player.conns) do pcall(function() c:Disconnect() end) end
    table.clear(Player.conns)
end

-- Own CharacterAdded binding (does not touch the respawn system). One set of listeners at a time:
-- re-applies on spawn and whenever the game changes the values back.
function Player.bind(char)
    Player.bindId += 1
    local id = Player.bindId
    Player.clearConns()
    if not char then return end

    task.spawn(function()
        local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 10)
        if not hum or State.destroyed or id ~= Player.bindId or LocalPlayer.Character ~= char then return end
        local function reapply() pcall(Player.apply, hum) end
        for _, prop in ipairs({ "WalkSpeed", "JumpPower", "JumpHeight", "UseJumpPower" }) do
            table.insert(Player.conns, hum:GetPropertyChangedSignal(prop):Connect(reapply))
        end
        reapply()
    end)
end

function Player.onJumpRequest()
    if not State.infJump or State.destroyed then return end
    if move.conn then return end -- the tween controller owns the character: never interfere
    local hum = Player.humanoid()
    if not hum or hum.Health <= 0 then return end
    pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
end

function Player.jumpOff()
    if Player.jumpConn then
        pcall(function() Player.jumpConn:Disconnect() end)
        Player.jumpConn = nil
    end
end

function Player.setInfJump(on)
    State.infJump = on
    saveSettings()
    if on then
        if not Player.jumpConn then -- never more than one connection
            Player.jumpConn = UserInputService.JumpRequest:Connect(Player.onJumpRequest)
        end
    else
        Player.jumpOff()
    end
end

table.insert(coreConns, LocalPlayer.CharacterAdded:Connect(Player.bind))
Player.bind(LocalPlayer.Character)

