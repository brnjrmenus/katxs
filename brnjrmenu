--[[
    Shop Tween  |  KAT X
    Auto-detects ShopModel pickups in Workspace.WorldIgnore.Pickups and tweens
    your character to them, optionally travelling just beneath the map surface.

    Includes: respawn-safe automation + lightweight Anti-AFK,
    plus a Player tab (ESP / WalkSpeed / JumpPower / Infinite Jump) and a crate counter.
]]

-- // Services
local Players          = game:GetService("Players")
local TweenService     = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService       = game:GetService("RunService")
local Workspace        = game:GetService("Workspace")
local CoreGui          = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer
while not LocalPlayer do
    task.wait()
    LocalPlayer = Players.LocalPlayer
end

-- // Re-execution guard (removes the previous instance)
local env = (getgenv and getgenv()) or _G
if env.__ShopTweenKATX and type(env.__ShopTweenKATX.Destroy) == "function" then
    pcall(env.__ShopTweenKATX.Destroy)
end

-- // Config
local CONFIG = {
    TargetName     = "ShopModel",
    MinSpeed       = 10,
    MaxSpeed       = 300,
    DefaultSpeed   = 80,
    SpeedStep      = 5,

    DefaultDepth   = 3,      -- studs below the surface
    MinDepth       = 0.5,
    MaxDepth       = 50,
    DepthStep      = 0.1,

    SegmentLength  = 20,     -- horizontal studs per tween segment (surface is re-sampled each segment)
    ArriveRadius   = 1,      -- horizontal distance at which we consider ourselves under the target
    RayHeadroom    = 12,     -- surface samples start this far above the last known surface
    RayDepth       = 300,    -- how far down surface rays reach

    FinalOffset    = Vector3.new(0, 3, 0), -- where you end up relative to the model's pivot
    DwellTime      = 0.35,
    IdleInterval   = 0.2,
    ScanInterval   = 1,
    StartEnabled   = false,

    -- Respawn handling
    PostSpawnDelay     = 3,     -- seconds to wait AFTER the new character is genuinely ready
    ReadyStableTime    = 0.5,   -- character must look "ready" continuously for this long first
    ReadyMoveTolerance = 10,    -- a position jump bigger than this (studs per poll) restarts the stable timer
    ReadyPollInterval  = 0.1,   -- how often the respawn waiter checks (cheap polling)
    RequireUnanchored  = true,  -- treat an anchored HumanoidRootPart as "still in the respawn box"

    -- Anti-AFK
    AntiAFK            = true,
    AntiAFKStopOnClose = false, -- false = Anti-AFK keeps running after you close the window

    -- Collection counter
    CollectRadius        = 12,  -- horizontal studs: a removal during the approach only counts if you're this close
    CollectConfirmWindow = 1.5, -- seconds after arriving (+ dwell) in which the model's removal still counts

    -- Player tab
    MinWalkSpeed     = 8,
    MaxWalkSpeed     = 200,
    DefaultWalkSpeed = 16,
    MinJumpPower     = 10,
    MaxJumpPower     = 250,
    DefaultJumpPower = 50,
    ESPFill          = Color3.fromRGB(124, 108, 255),
    ESPOutline       = Color3.fromRGB(255, 255, 255),
    ESPFillAlpha     = 0.55,
}

-- // Anti-AFK (independent of everything below; one connection, replaced on re-execute)
local function startAntiAFK()
    local old = env.__ShopTweenKATXAntiAFK
    if old and type(old.Disconnect) == "function" then
        pcall(old.Disconnect)
    end
    env.__ShopTweenKATXAntiAFK = nil
    if not CONFIG.AntiAFK then return nil end

    local okVU, VirtualUser = pcall(function() return game:GetService("VirtualUser") end)
    if not okVU or not VirtualUser then
        warn("[ShopTween] VirtualUser unavailable - Anti-AFK disabled")
        return nil
    end

    local conn = LocalPlayer.Idled:Connect(function()
        -- Event-driven: only runs when Roblox reports the player as idle. No movement, no teleporting.
        pcall(function()
            VirtualUser:CaptureController()
            VirtualUser:ClickButton2(Vector2.new(0, 0))
        end)
    end)

    local handle = {}
    function handle.Disconnect()
        pcall(function() conn:Disconnect() end)
        if env.__ShopTweenKATXAntiAFK == handle then
            env.__ShopTweenKATXAntiAFK = nil
        end
    end
    env.__ShopTweenKATXAntiAFK = handle
    return handle
end

local antiAFK = startAntiAFK()

-- // Settings persisted while the script is running (survive re-execution too)
local saved = env.__ShopTweenKATXSettings
if type(saved) ~= "table" then
    saved = {}
    env.__ShopTweenKATXSettings = saved
end

local function snapValue(v, minV, maxV, step)
    local k = math.floor((v - minV) / step + 0.5)
    v = math.clamp(minV + k * step, minV, maxV)
    return math.floor(v * 1000 + 0.5) / 1000
end

local function numOr(v, default)
    return type(v) == "number" and v == v and v or default
end

-- // State
local State = {
    enabled      = false,   -- the user's ON/OFF choice (never changed by respawns)
    paused       = false,   -- true while respawning: nothing is allowed to target/move
    respawnText  = nil,
    underMap     = saved.underMap ~= false,
    autoTarget   = saved.autoTarget ~= false,
    speed        = snapValue(numOr(saved.speed, CONFIG.DefaultSpeed), CONFIG.MinSpeed, CONFIG.MaxSpeed, CONFIG.SpeedStep),
    depth        = snapValue(numOr(saved.depth, CONFIG.DefaultDepth), CONFIG.MinDepth, CONFIG.MaxDepth, CONFIG.DepthStep),
    depthVersion = 0,       -- bumped whenever the depth slider changes
    token        = 0,       -- invalidates old automation loops / tween waits
    tween        = nil,
    current      = nil,
    phase        = nil,
    underground  = false,
    surfaceY     = nil,     -- last sampled surface height at the character's position
    manualOnce   = false,
    destroyed    = false,
    notice       = "",
    noticeUntil  = 0,

    -- Player tab / counter (nil walkSpeed / jumpPower = "never touched, leave the game's value alone")
    collected    = math.max(math.floor(numOr(saved.collected, 0)), 0),
    walkSpeed    = type(saved.walkSpeed) == "number" and math.clamp(saved.walkSpeed, CONFIG.MinWalkSpeed, CONFIG.MaxWalkSpeed) or nil,
    jumpPower    = type(saved.jumpPower) == "number" and math.clamp(saved.jumpPower, CONFIG.MinJumpPower, CONFIG.MaxJumpPower) or nil,
    infJump      = saved.infJump == true,
    esp          = saved.esp == true,
}

-- Respawn bookkeeping
local respawn = {
    session  = 0,                              -- bumped to cancel the active waiter (Destroy)
    waiting  = false,                          -- true while exactly one waiter is running
    bindId   = 0,                              -- guards async Humanoid binding
    diedConn = nil,                            -- Humanoid.Died of the current character
    dead     = setmetatable({}, { __mode = "k" }), -- characters known to be dead/removed
}

local function saveSettings()
    saved.speed      = State.speed
    saved.depth      = State.depth
    saved.underMap   = State.underMap
    saved.autoTarget = State.autoTarget
    saved.collected  = State.collected
    saved.walkSpeed  = State.walkSpeed
    saved.jumpPower  = State.jumpPower
    saved.infJump    = State.infJump
    saved.esp        = State.esp
end

local pending      = {}
local pendingCount = 0
local visited      = setmetatable({}, { __mode = "k" })
local modelConns   = {}
local scanConns    = {}
local scanFolder   = nil
local scanToken    = 0
local coreConns    = {}

-- // Helpers
-- Automation may only act while enabled, not respawning, and on the current token.
local function alive(token)
    return not State.destroyed and State.enabled and not State.paused and token == State.token
end

local function notify(msg)
    State.notice = msg
    State.noticeUntil = os.clock() + 2.5
end

local function getCharacter()
    local char = LocalPlayer.Character
    if not char or respawn.dead[char] then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hrp:IsA("BasePart") or not hum or hum.Health <= 0 then return nil end
    return hrp, hum, char
end

local function getTargetPosition(model)
    if not model then return nil end
    if model:IsA("BasePart") then return model.Position end
    if not model:FindFirstChildWhichIsA("BasePart", true) then return nil end
    local ok, cf = pcall(function() return model:GetPivot() end)
    if ok and typeof(cf) == "CFrame" then return cf.Position end
    return nil
end

local function isValid(model)
    return scanFolder ~= nil and model.Parent ~= nil and model:IsDescendantOf(scanFolder)
end

local function floorLimit()
    return Workspace.FallenPartsDestroyHeight + 15
end

-- Height the character travels at for a given surface height (never above the surface)
local function travelY(surface)
    local y = math.max(surface - State.depth, floorLimit())
    return math.min(y, surface - CONFIG.MinDepth)
end

-- // Surface detection (raycasts ignore your character, other players, the camera and WorldIgnore)
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true
pcall(function() rayParams.RespectCanCollide = true end)

local function refreshRayFilter(char)
    local list = {}
    if char then list[#list + 1] = char end
    local wi = Workspace:FindFirstChild("WorldIgnore")
    if wi then list[#list + 1] = wi end
    if Workspace.CurrentCamera then list[#list + 1] = Workspace.CurrentCamera end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then list[#list + 1] = plr.Character end
    end
    rayParams.FilterDescendantsInstances = list
end

-- Ground under the character (cast from the root part itself, so roofs above are ignored)
local function groundBelow(hrp, hum, char)
    refreshRayFilter(char)
    local res = Workspace:Raycast(hrp.Position, Vector3.new(0, -CONFIG.RayDepth, 0), rayParams)
    if res then return res.Position.Y end
    local hip = (hum and hum.HipHeight > 0) and hum.HipHeight or 2
    return hrp.Position.Y - (hip + hrp.Size.Y / 2)
end

-- Surface at (x, z), starting just above the previous surface so roofs/ceilings higher up are ignored
local function sampleSurface(x, z, ref, char)
    refreshRayFilter(char)
    local origin = Vector3.new(x, ref + CONFIG.RayHeadroom, z)
    local res = Workspace:Raycast(origin, Vector3.new(0, -(CONFIG.RayHeadroom + CONFIG.RayDepth), 0), rayParams)
    if res then return res.Position.Y end
    return ref
end

-- // Pending queue
local function removePending(model)
    if pending[model] then
        pending[model] = nil
        pendingCount = math.max(pendingCount - 1, 0)
    end
end

local function addPending(model)
    if not pending[model] then
        pending[model] = true
        pendingCount += 1
    end
end

-- // Tween control
local function cancelTween()
    local t = State.tween
    State.tween = nil
    if t then pcall(function() t:Cancel() end) end
end

-- // Movement controller (noclip, zero velocity, position hold between tweens)
local move = { conn = nil, parts = nil, hum = nil, hrp = nil, wasPlatform = false, hold = nil }

local function endMovement()
    if move.conn then move.conn:Disconnect() move.conn = nil end
    move.hold = nil
    if move.parts then
        for part, orig in pairs(move.parts) do
            if part.Parent then pcall(function() part.CanCollide = orig end) end
        end
    end
    if move.hum and move.hum.Parent then
        pcall(function() move.hum.PlatformStand = move.wasPlatform end)
    end
    if move.hrp and move.hrp.Parent then
        pcall(function()
            move.hrp.AssemblyLinearVelocity = Vector3.zero
            move.hrp.AssemblyAngularVelocity = Vector3.zero
        end)
    end
    move.parts, move.hum, move.hrp = nil, nil, nil
end

local function holdHere(hrp)
    if move.hrp == hrp and hrp.Parent then move.hold = hrp.CFrame end
end

local function beginMovement(char, hrp, hum)
    if move.conn and move.hrp == hrp then return end
    endMovement()
    move.parts = {}
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("BasePart") then
            move.parts[d] = d.CanCollide
            d.CanCollide = false
        end
    end
    move.hum, move.hrp = hum, hrp
    move.wasPlatform = hum.PlatformStand
    move.hold = hrp.CFrame
    hum.PlatformStand = true
    move.conn = RunService.Stepped:Connect(function(_, dt)
        local parts = move.parts
        if parts then
            for part in pairs(parts) do part.CanCollide = false end
        end
        if not hrp.Parent then return end
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero

        -- Between tweens: stay put (no gravity drift). While idle underground, follow the depth slider live.
        if State.tween == nil and move.hold then
            local hold = move.hold
            if State.underground and State.underMap and State.surfaceY then
                local dy = travelY(State.surfaceY) - hold.Position.Y
                if math.abs(dy) > 0.01 then
                    local stepY = math.clamp(dy, -State.speed * dt, State.speed * dt)
                    hold = hold + Vector3.new(0, stepY, 0)
                    move.hold = hold
                end
            end
            hrp.CFrame = hold
        end
    end)
end

-- Safety: if stopped while under the map, lift the character back above the surface
local function rescue()
    if not State.underground then return end
    local hrp = move.hrp or getCharacter()
    if hrp and hrp.Parent then
        pcall(function()
            local p = hrp.Position
            local rot = hrp.CFrame - p
            local y = math.max((State.surfaceY or p.Y) + 3, p.Y)
            hrp.CFrame = CFrame.new(p.X, y, p.Z) * rot
        end)
    end
    move.hold = nil
    State.underground = false
end

local function resetMovementState()
    cancelTween()
    endMovement()
    State.underground = false
    State.surfaceY = nil
end

-- // Single tween segment. Returns "done" | "retarget" | "stopped"
local function tweenTo(hrp, pos, token, watchDepth)
    if not alive(token) or not hrp.Parent then return "stopped" end

    local current = hrp.CFrame
    local goal = CFrame.new(pos) * (current - current.Position)
    local dist = (current.Position - pos).Magnitude
    if dist < 0.25 then
        hrp.CFrame = goal
        holdHere(hrp)
        return "done"
    end

    local duration = math.max(dist / math.max(State.speed, 1), 0.03)
    cancelTween()
    local tween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = goal })
    State.tween = tween

    local finished, result, retarget = false, nil, false
    local conn = tween.Completed:Connect(function(s)
        finished, result = true, s
    end)
    local ver = State.depthVersion
    tween:Play()

    local t0 = os.clock()
    while not finished do
        if not alive(token) or not hrp.Parent or os.clock() - t0 > duration + 2 then break end
        if watchDepth and State.depthVersion ~= ver then retarget = true break end
        task.wait()
    end
    conn:Disconnect()

    if not finished then pcall(function() tween:Cancel() end) end
    if State.tween == tween then State.tween = nil end
    holdHere(hrp)

    if retarget then return "retarget" end
    -- A finished tween from an invalidated run (death/respawn/toggle) must not count as success
    if not alive(token) then return "stopped" end
    if finished and result == Enum.PlaybackState.Completed then return "done" end
    return "stopped"
end

local function waitAlive(seconds, token)
    local t0 = os.clock()
    while alive(token) and os.clock() - t0 < seconds do
        task.wait(0.05)
    end
end

-- // Underground travel
-- 1) dive to (surface - depth)  2) glide horizontally in short segments, re-sampling the surface each segment
local function travelUnder(hrp, model, token)
    local char = hrp.Parent

    State.phase = "Diving"
    while alive(token) do
        local p = hrp.Position
        local r = tweenTo(hrp, Vector3.new(p.X, travelY(State.surfaceY), p.Z), token, true)
        if r == "done" then break end
        if r == "stopped" then return false end
        -- "retarget": depth changed, recompute and go again
    end

    State.phase = "Travelling underground"
    while alive(token) do
        if not hrp.Parent then return false end
        local tp = getTargetPosition(model)
        if not tp then return false end

        local p = hrp.Position
        local flat = Vector3.new(tp.X - p.X, 0, tp.Z - p.Z)
        local dist = flat.Magnitude
        if dist <= CONFIG.ArriveRadius then break end

        local step = math.min(dist, CONFIG.SegmentLength)
        local nx = p.X + flat.X / dist * step
        local nz = p.Z + flat.Z / dist * step

        State.surfaceY = sampleSurface(nx, nz, State.surfaceY, char)
        local r = tweenTo(hrp, Vector3.new(nx, travelY(State.surfaceY), nz), token, true)
        if r == "stopped" then return false end
        -- "done" or "retarget": loop again from the actual position
    end
    return alive(token)
end

-- // Collection counter
-- A crate is counted ONLY when the exact ShopModel our automation was collecting is confirmed removed
-- from Workspace. Each armed model gets its own AncestryChanged watch (no global DescendantRemoving).
--   arm()         : final approach to the model begins (called from processTarget)
--   markReached() : the final tween finished, i.e. we are physically on the pickup
--   settle()      : the attempt ended without reaching it (short grace for in-flight removal events)
-- Unreached watches only count if the automation is still live AND the character is near the model.
-- Reached watches count for DwellTime + CollectConfirmWindow (covers replication lag after we move on).
local Collect = {
    watches  = {},                                  -- [model] = { token, pos, reached, expires, conn }
    counted  = setmetatable({}, { __mode = "k" }),  -- a model can never be counted twice
    onChange = nil,                                 -- set by the UI
}

function Collect.drop(model)
    local w = Collect.watches[model]
    if w then
        Collect.watches[model] = nil
        if w.conn then pcall(function() w.conn:Disconnect() end) end
    end
end

function Collect.expire(model, w, after)
    w.expires = os.clock() + after
    task.delay(after, function()
        if Collect.watches[model] == w then Collect.drop(model) end
    end)
end

function Collect.near(model, w)
    local hrp = getCharacter()
    local pos = getTargetPosition(model) or w.pos
    if not hrp or not pos then return false end
    local p = hrp.Position
    return Vector3.new(p.X - pos.X, 0, p.Z - pos.Z).Magnitude <= CONFIG.CollectRadius
end

function Collect.confirm(model, w)
    if Collect.watches[model] ~= w then return end
    if model:IsDescendantOf(Workspace) then return end -- only moved around inside Workspace: not removed
    local valid = os.clock() <= w.expires
    local ok = valid and (w.reached or (alive(w.token) and Collect.near(model, w)))
    Collect.drop(model)
    if not ok or Collect.counted[model] then return end
    Collect.counted[model] = true
    State.collected += 1
    saveSettings()
    if Collect.onChange then pcall(Collect.onChange, true) end
end

function Collect.arm(model, token)
    if Collect.counted[model] then return end
    Collect.drop(model)
    local w = { token = token, pos = getTargetPosition(model), reached = false, expires = math.huge }
    Collect.watches[model] = w
    w.conn = model.AncestryChanged:Connect(function()
        Collect.confirm(model, w)
    end)
end

function Collect.markReached(model)
    local w = Collect.watches[model]
    if not w then return end
    w.reached = true
    Collect.expire(model, w, CONFIG.DwellTime + CONFIG.CollectConfirmWindow)
end

function Collect.settle(model)
    local w = Collect.watches[model]
    if w and not w.reached and w.expires == math.huge then
        Collect.expire(model, w, 0.5)
    end
end

function Collect.disarmAll()
    for model in pairs(Collect.watches) do Collect.drop(model) end
end

-- // Target processing
local function processTarget(model, token)
    local hrp, hum, char = getCharacter()
    if not hrp then return false end
    local pos = getTargetPosition(model)
    if not pos then return true end

    beginMovement(char, hrp, hum)

    if State.underMap then
        if not State.underground then
            State.surfaceY = groundBelow(hrp, hum, char)
            State.underground = true
        end
        if not travelUnder(hrp, model, token) then return false end

        local p2 = getTargetPosition(model)
        if not p2 then return false end
        State.phase = "Surfacing"
        Collect.arm(model, token)
        if tweenTo(hrp, p2 + CONFIG.FinalOffset, token, false) ~= "done" then return false end
        Collect.markReached(model)
        State.underground = false
    else
        if State.underground then
            -- Under Map Mode was switched off while underground: come back up first
            State.phase = "Surfacing"
            local p = hrp.Position
            local y = math.max((State.surfaceY or p.Y) + CONFIG.FinalOffset.Y, p.Y)
            if tweenTo(hrp, Vector3.new(p.X, y, p.Z), token, false) ~= "done" then return false end
            State.underground = false
        end
        State.phase = "Travelling"
        local p2 = getTargetPosition(model)
        if not p2 then return false end
        Collect.arm(model, token)
        if tweenTo(hrp, p2 + CONFIG.FinalOffset, token, false) ~= "done" then return false end
        Collect.markReached(model)
    end

    State.phase = "Collecting"
    waitAlive(CONFIG.DwellTime, token)
    if not State.underground and alive(token) then endMovement() end
    return alive(token)
end

local function pickNearest()
    local hrp = getCharacter()
    local origin = hrp and hrp.Position
    local best, bestDist
    for model in pairs(pending) do
        if not isValid(model) then
            removePending(model)
        else
            local pos = getTargetPosition(model)
            if pos then
                local d = origin and (pos - origin).Magnitude or 0
                if not bestDist or d < bestDist then
                    best, bestDist = model, d
                end
            end
        end
    end
    return best
end

local function mainLoop(token)
    while alive(token) do
        local target
        if State.autoTarget or State.manualOnce then
            target = pickNearest()
            if State.manualOnce then
                State.manualOnce = false
                if not target then notify("No ShopModel available") end
            end
        end

        if not target then
            State.phase = nil
            task.wait(CONFIG.IdleInterval)
        else
            State.current = target
            removePending(target)
            visited[target] = true

            local ok, completed = pcall(processTarget, target, token)
            if not ok then
                warn("[ShopTween] " .. tostring(completed))
                completed = false
            end
            Collect.settle(target)

            -- Only touch shared state if this loop is still the current one
            if token == State.token then
                State.current = nil
                State.phase = nil
            end
            if not alive(token) then return end

            -- Interrupted (character not ready etc.) but still exists: put it back in the queue
            if not completed and isValid(target) then
                visited[target] = nil
                addPending(target)
                task.wait(0.3)
            end
        end
    end
end

-- // Scanner (detects existing + newly spawned ShopModels)
local function registerModel(inst)
    if inst.Name ~= CONFIG.TargetName then return end
    if not (inst:IsA("Model") or inst:IsA("BasePart")) then return end
    if visited[inst] or pending[inst] then return end

    addPending(inst)
    if not modelConns[inst] then
        modelConns[inst] = inst.AncestryChanged:Connect(function()
            if not isValid(inst) then
                removePending(inst)
                local c = modelConns[inst]
                if c then c:Disconnect() modelConns[inst] = nil end
                if State.current == inst then cancelTween() end
            end
        end)
    end
end

local function detachFolder()
    for _, c in ipairs(scanConns) do c:Disconnect() end
    table.clear(scanConns)
    for _, c in pairs(modelConns) do c:Disconnect() end
    table.clear(modelConns)
    table.clear(pending)
    pendingCount = 0
    scanFolder = nil
end

local function syncFolder()
    local wi = Workspace:FindFirstChild("WorldIgnore")
    local folder = wi and wi:FindFirstChild("Pickups")
    if folder == scanFolder then return end
    detachFolder()
    if not folder then return end

    scanFolder = folder
    scanConns[1] = folder.DescendantAdded:Connect(function(d)
        pcall(registerModel, d)
    end)
    for _, d in ipairs(folder:GetDescendants()) do
        pcall(registerModel, d)
    end
end

local function startScanner()
    scanToken += 1
    local myToken = scanToken
    task.spawn(function()
        while myToken == scanToken and not State.destroyed do
            local ok, err = pcall(syncFolder)
            if not ok then warn("[ShopTween] scan error: " .. tostring(err)) end
            task.wait(CONFIG.ScanInterval)
        end
    end)
end

local function stopScanner()
    scanToken += 1
    detachFolder()
end

-- // Start / stop
-- The ONLY place automation loops are started. Bumping the token retires any older loop,
-- so two loops can never both be "alive". Does nothing while respawning.
local function launchLoop()
    if State.destroyed or not State.enabled or State.paused then return end
    State.token += 1
    task.spawn(mainLoop, State.token)
end

local function startAll()
    if State.enabled or State.destroyed then return end
    State.enabled = true
    startScanner()
    launchLoop() -- no-op while respawning; finishRespawn() launches it afterwards
end

local function stopAll()
    State.token += 1
    State.enabled = false
    cancelTween()
    stopScanner()
    if State.current then visited[State.current] = nil end
    rescue()
    endMovement()
    State.current, State.phase = nil, nil
    State.manualOnce = false
end

-- // Respawn handling
-- Flow:  Died / CharacterRemoving -> beginRespawn()  (instant hard stop, State.paused = true)
--        waiter polls until a NEW living character is genuinely ready (+ stable)
--        then waits PostSpawnDelay more seconds
--        finishRespawn() -> State.paused = false and the loop is relaunched if still ON
local function characterReady(char)
    if not char or respawn.dead[char] then return false end
    if LocalPlayer.Character ~= char then return false end
    if not char:IsDescendantOf(Workspace) then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp or not hrp:IsA("BasePart") then return false end
    if hum.Health <= 0 or hum:GetState() == Enum.HumanoidStateType.Dead then return false end
    if CONFIG.RequireUnanchored and hrp.Anchored then return false end
    return true, hrp
end

-- Waits until a new character has looked ready continuously for ReadyStableTime.
local function awaitReady(valid)
    local lastChar, lastPos, stableSince
    while valid() do
        local char = LocalPlayer.Character
        local ok, hrp = characterReady(char)
        if ok then
            local now = os.clock()
            if char ~= lastChar then
                lastChar, lastPos, stableSince = char, hrp.Position, now
            else
                local p = hrp.Position
                if (p - lastPos).Magnitude > CONFIG.ReadyMoveTolerance then
                    stableSince = now -- got teleported (e.g. out of the respawn box): start over
                end
                lastPos = p
            end
            if now - stableSince >= CONFIG.ReadyStableTime then
                return char
            end
        else
            lastChar, lastPos, stableSince = nil, nil, nil
        end
        State.respawnText = "Respawning - waiting for spawn"
        task.wait(CONFIG.ReadyPollInterval)
    end
    return nil
end

local function finishRespawn()
    respawn.waiting = false
    State.paused = false
    State.respawnText = nil
    if State.enabled then
        launchLoop() -- resumes automatically; no OFF/ON toggle needed
    end
end

local function runRespawnWait(session)
    local function valid()
        return respawn.session == session and not State.destroyed
    end

    while valid() do
        local char = awaitReady(valid)
        if not char then return end

        -- Character is genuinely ready: now wait the extra delay, re-checking it the whole time
        local t0 = os.clock()
        local lost = false
        while valid() do
            local remaining = CONFIG.PostSpawnDelay - (os.clock() - t0)
            if remaining <= 0 then break end
            if LocalPlayer.Character ~= char or not characterReady(char) then
                lost = true -- died / replaced during the delay: start the whole wait over
                break
            end
            State.respawnText = string.format("Spawned - resuming in %.1fs", remaining)
            task.wait(CONFIG.ReadyPollInterval)
        end
        if not valid() then return end

        if not lost and LocalPlayer.Character == char and characterReady(char) then
            finishRespawn()
            return
        end
    end
end

-- Instantly gates ALL automation. Safe to call repeatedly (Died + CharacterRemoving both call it):
-- only one waiter ever exists.
local function beginRespawn()
    if State.destroyed then return end
    State.paused = true
    State.token += 1            -- retires the running loop and every tween wait
    State.manualOnce = false

    -- Cancel the active target and put it back in the queue so it isn't lost
    local cur = State.current
    State.current, State.phase = nil, nil
    if cur and isValid(cur) then
        visited[cur] = nil
        addPending(cur)
    end

    resetMovementState()        -- cancels tween, disconnects movement hook, clears underground state
    State.respawnText = "Respawning - waiting for spawn"

    if not respawn.waiting then
        respawn.waiting = true
        respawn.session += 1
        task.spawn(runRespawnWait, respawn.session)
    end
end

local function handleDeath(char)
    if char then respawn.dead[char] = true end
    beginRespawn()
end

-- Always re-binds to the current character's Humanoid (one Died connection at a time)
local function bindCharacter(char)
    respawn.bindId += 1
    local id = respawn.bindId
    if respawn.diedConn then
        respawn.diedConn:Disconnect()
        respawn.diedConn = nil
    end
    if not char then return end

    task.spawn(function()
        local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 10)
        if not hum or State.destroyed or id ~= respawn.bindId or LocalPlayer.Character ~= char then return end
        respawn.diedConn = hum.Died:Connect(function()
            handleDeath(char)
        end)
        if hum.Health <= 0 then handleDeath(char) end
    end)
end

