        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(14, 5),
        Size = UDim2.new(1, -80, 0, 18),
    }, f)
    mk("TextLabel", {
        Text = desc,
        Font = Enum.Font.Gotham,
        TextSize = 11,
        TextColor3 = THEME.muted,
        TextXAlignment = Enum.TextXAlignment.Left,
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(14, 22),
        Size = UDim2.new(1, -80, 0, 14),
    }, f)

    local function renderName(v)
        if not showState then return end
        nameLbl.Text = label .. ': <font color="' .. rgbStr(v and THEME.on or THEME.muted) .. '">'
            .. (v and "ON" or "OFF") .. "</font>"
    end

    local setVisual = makeSwitch(f)
    local value = initial
    setVisual(value, true)
    renderName(value)

    local btn = overlay(f)
    attachFx(btn, f, scale)
    btn.MouseButton1Click:Connect(function()
        value = not value
        setVisual(value)
        renderName(value)
        onChanged(value)
    end)
end

